; Engine configuration file.
; Best edited in the Godot editor, but valid as-is.

config_version=5

[application]

config/name="Soldat Reborn"
config/version="1.9.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Sfx="*res://scripts/sfx.gd"
Settings="*res://scripts/settings.gd"
Net="*res://scripts/net.gd"
GifRecorder="*res://scripts/gif_recorder.gd"
Stats="*res://scripts/stats.gd"
Music="*res://scripts/music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

