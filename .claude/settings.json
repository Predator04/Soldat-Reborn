{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit(*.gd)",
        "hooks": [
          { "type": "command", "command": "bash tools/check_gd.sh" }
        ]
      },
      {
        "matcher": "Write(*.gd)",
        "hooks": [
          { "type": "command", "command": "bash tools/check_gd.sh" }
        ]
      }
    ]
  }
}
